# Google Ads MCP サーバー 環境変数テンプレート
# このファイルはコミット可能。実値は .env.local にコピーして埋める。
#
# 使い方（ローカル）:
#   cp .env.example .env.local
#   # .env.local を編集
#   set -a && source .env.local && set +a
#
# Vercel 本番:
#   vercel env add <KEY> production  で個別登録

# --- Google Ads API ---
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=1//your-refresh-token
# MCC（マネージャアカウント）配下の運用なので必須。ハイフン無しの 10 桁。
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# --- MCP サーバー認証 ---
# クライアント（Claude Desktop 等）から Authorization: Bearer で送る共有秘密。
# 生成例: openssl rand -hex 32
JWT_SECRET=hoge
JWT_SALT=hoge
MCP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# --- 任意 ---
# CORS で許可するオリジン（カンマ区切り）。未設定なら無効。
# ALLOWED_ORIGINS=https://claude.ai
